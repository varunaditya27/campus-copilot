GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:3000
# RAG_TOP_K=3
# RAG_RRF_K=60
# RAG_RERANK_MIN_SCORE=-8.5
# VECTOR_STORE=chroma            # or qdrant
# CHROMA_DIR=/path/to/store
# CHROMA_HOST=localhost          # use a Chroma server instead of local files
# CHROMA_PORT=8000
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# KNOWLEDGE_UPLOAD_DIR=/path/to/uploads
COOKIE_SECURE=false
# AGENT_PLANNING=false          # true: plan multi-step requests first (extra model call)
# MULTI_AGENT=false             # true: route each question to a specialist agent (extra model call)
# LLM_PROVIDER=groq             # groq | openai | ollama
# LLM_MODEL=                    # required for openai and ollama; Groq defaults to openai/gpt-oss-120b
# LLM_MODEL_FAST=               # optional per-tier models ("fast" and "best"); unset means LLM_MODEL
# LLM_MODEL_BEST=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=              # any OpenAI-compatible server
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_AUTH=10/minute
# REDIS_URL=redis://localhost:6379/0   # needed for limits across several processes
# PROMPT_GUARD=block            # block | log | off
# ADMIN_API_KEY_HASHES=         # from: python -m app.cli create-admin-key
# ENVIRONMENT=development       # production refuses unsafe settings
# LOG_FORMAT=json              # json | console
# OTEL_EXPORTER_OTLP_ENDPOINT=  # for example http://localhost:4318
# SENTRY_DSN=
# EMBEDDING_PROVIDER=local      # local | ollama | openai (changing it needs: python -m app.rag.ingest --full)
# EMBEDDING_MODEL=              # ollama default nomic-embed-text, openai default text-embedding-3-small
# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Leave unset for a local SQLite file; set for PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://campus:password@localhost:5432/campus_copilot
