# Settings for `docker compose`. Copy to .env and fill in the three required values.
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
GROQ_API_KEY=

# Where the browser reaches the backend, and the page addresses the backend accepts requests from.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# true once the site is served over HTTPS
COOKIE_SECURE=false

# Optional: another language model or embedding model (see backend/README.md)
# LLM_PROVIDER=groq
# LLM_MODEL=
# EMBEDDING_PROVIDER=local
# MULTI_AGENT=false

# Optional: monitoring (docker compose --profile monitoring up -d)
# GRAFANA_PASSWORD=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: change the published ports (all bound to localhost)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432

# Production only (docker-compose.prod.yml)
# DOMAIN=campus.example.org
# IMAGE_PREFIX=ghcr.io/your-github-name/campus-copilot
# IMAGE_TAG=latest
