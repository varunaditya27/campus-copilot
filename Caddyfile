# Caddy gets and renews a Let's Encrypt certificate for DOMAIN by itself, redirects HTTP to HTTPS,
# and sends the API paths to the backend and everything else to the frontend, so the browser only
# ever talks to one HTTPS address.
{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /health
	handle @backend {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
